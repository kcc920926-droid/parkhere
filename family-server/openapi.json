  "components": {
    "securitySchemes": {
      "carToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "`POST /api/car/drivers`가 돌려준 carToken"
      },
      "familyToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "`POST /api/family/members`가 돌려준 token"
      }
    },
    "parameters": {
      "driverId": {
        "name": "driverId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "연결할 때 받은 운전자 ID"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "오류 코드"
          }
        }
      },
      "ShareScope": {
        "type": "string",
        "enum": [
          "status",
          "evidence"
        ],
        "description": "status: 상태만 · evidence: 상태와 숫자 근거"
      },
      "WeeklyStatus": {
        "type": "string",
        "enum": [
          "learning",
          "insufficient",
          "stable",
          "observe",
          "talk"
        ],
        "description": "학습 중 · 자료 부족 · 안정 · 관찰 · 대화 권장. drivewatch-core의 주간 판정 결과"
      },
      "DriverRegistration": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 20
          },
          "shareScope": {
            "$ref": "#/components/schemas/ShareScope"
          }
        }
      },
      "Evidence": {
        "type": "object",
        "required": [
          "label",
          "value"
        ],
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 40
          },
          "unit": {
            "type": "string",
            "maxLength": 20,
            "description": "예: 회/100km"
          },
          "typical": {
            "type": "number",
            "nullable": true,
            "description": "평소 값"
          },
          "value": {
            "type": "number",
            "description": "이번 주 값"
          },
          "weeks": {
            "type": "integer",
            "nullable": true,
            "description": "연속으로 평소를 넘은 주 수"
          }
        }
      },
      "SummaryInput": {
        "type": "object",
        "required": [
          "week",
          "status"
        ],
        "properties": {
          "week": {
            "type": "string",
            "format": "date",
            "description": "그 주의 월요일 (YYYY-MM-DD)"
          },
          "status": {
            "$ref": "#/components/schemas/WeeklyStatus"
          },
          "headline": {
            "type": "string",
            "maxLength": 120,
            "description": "한 줄 요약. 안정일 때 보인다"
          },
          "goodPoints": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "string",
              "maxLength": 80
            },
            "description": "잘하신 점"
          },
          "promise": {
            "type": "string",
            "maxLength": 80,
            "description": "약속 이행"
          },
          "avoided": {
            "type": "string",
            "maxLength": 80,
            "description": "피한 구간. 지명은 운전자가 붙인 이름만 쓴다"
          },
          "changes": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "string",
              "maxLength": 120
            },
            "description": "달라진 점을 말로 적은 것. 범위와 무관하게 전달된다"
          },
          "evidence": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "description": "숫자 근거. 범위가 evidence일 때만 저장된다"
          }
        }
      },
      "Trip": {
        "type": "object",
        "description": "주행 한 번의 횟수 요약. 위치·경로·시각은 받지 않으며, 그 밖의 필드는 버린다.",
        "required": [
          "week",
          "km",
          "reroutes",
          "turns",
          "signals",
          "hardBrakes"
        ],
        "properties": {
          "week": {
            "type": "string",
            "format": "date",
            "description": "주행한 주의 월요일"
          },
          "place": {
            "type": "string",
            "maxLength": 20,
            "description": "목적지 이름(예: 병원). 주소가 아니다"
          },
          "km": {
            "type": "number",
            "minimum": 0,
            "maximum": 2000
          },
          "night": {
            "type": "boolean",
            "description": "해 진 뒤 주행"
          },
          "reroutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000,
            "description": "경로 재탐색 횟수"
          },
          "turns": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000,
            "description": "회전 안내 횟수"
          },
          "signals": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000,
            "description": "회전 안내 중 방향지시등을 켠 횟수(turns 이하)"
          },
          "hardBrakes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          }
        },
        "example": {
          "week": "2026-11-09",
          "place": "병원",
          "km": 10,
          "night": false,
          "reroutes": 2,
          "turns": 3,
          "signals": 2,
          "hardBrakes": 1
        }
      },
      "Profile": {
        "type": "object",
        "properties": {
          "promises": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            },
            "maxItems": 10,
            "description": "고른 운전 약속 번호"
          },
          "marked": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "properties": {
                "place": {
                  "type": "string",
                  "maxLength": 20
                },
                "point": {
                  "type": "string",
                  "maxLength": 30
                }
              }
            },
            "description": "목적지별로 표시한 불편 구간"
          }
        },
        "example": {
          "promises": [
            0,
            1
          ],
          "marked": [
            {
              "place": "병원",
              "point": "중앙대로 합류"
            }
          ]
        }
      }
    }
  },
  "x-error-codes": {
    "name_required": "이름이 비어 있다",
    "invalid_scope": "범위가 status나 evidence가 아니다",
    "invalid_week": "week가 YYYY-MM-DD 날짜가 아니다",
    "invalid_status": "status가 정해진 다섯 값이 아니다",
    "invalid_json": "본문이 JSON이 아니다",
    "body_too_large": "본문이 16KB를 넘는다",
    "unauthorized": "토큰이 없거나 맞지 않는다",
    "not_linked": "그 운전자와 연결되지 않은 가족이다",
    "invalid_code": "그런 초대 코드가 없다",
    "expired_code": "초대 코드의 10분이 지났다",
    "no_summary": "그 주의 요약이 없다",
    "too_many_attempts": "코드를 10분 안에 5번 틀렸다",
    "rate_limited": "한 주소에서 요청이 너무 많다 (등록 1시간 10번, 연결 10분 10번, 쓰기 1분 120번)",
    "capacity_reached": "시연 서버의 등록 상한에 닿았다",
    "not_found": "그런 주소가 없다",
    "server_error": "서버 오류",
    "backup_off": "주행 기록 보관이 꺼져 있다",
    "invalid_backup": "enabled는 true 또는 false",
    "invalid_count": "횟수가 정수가 아니거나 범위를 벗어났다(signals는 turns 이하)",
    "invalid_km": "km가 0~2000이 아니다"
  }
}
