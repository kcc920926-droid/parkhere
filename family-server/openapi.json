{
  "openapi": "3.0.3",
  "info": {
    "title": "DriveWatch 가족 요약 API",
    "version": "0.2.0",
    "description": "차량 앱이 주간 요약을 보내고, 연결된 가족이 폰 웹 화면에서 읽는다. 시연용이다.\n\n- 초대 코드는 운전자가 차에서 띄운다. 6자리, 10분, 한 번만 쓸 수 있다.\n- 운전자가 `status`(상태만)를 고르면 숫자 근거는 저장하지도, 내보내지도 않는다.\n- 위치와 경로는 받지 않는다. 요약에서 정해진 항목만 저장한다.\n- 요청과 응답은 JSON이다. 본문은 16KB까지다."
  },
  "servers": [
    {
      "url": "https://drive.olvend.com",
      "description": "공개 시연 서버"
    },
    {
      "url": "http://127.0.0.1:8795",
      "description": "로컬"
    },
    {
      "url": "http://10.0.2.2:8795",
      "description": "Pleos 에뮬레이터 안에서 본 로컬"
    }
  ],
  "tags": [
    {
      "name": "차량 앱",
      "description": "차량 앱이 부른다. 등록할 때 받은 carToken을 `Authorization: Bearer`로 붙인다."
    },
    {
      "name": "가족 폰",
      "description": "폰 웹 화면이 부른다. 가입할 때 받은 token을 `Authorization: Bearer`로 붙인다."
    }
  ],
  "paths": {
    "/api/car/drivers": {
      "post": {
        "tags": [
          "차량 앱"
        ],
        "summary": "운전자 등록",
        "description": "운전자 프로필 하나를 등록하고 carToken을 받는다. carToken은 다시 받을 수 없으니 차량 앱이 보관한다.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DriverRegistration"
              },
              "example": {
                "name": "김정숙",
                "shareScope": "status"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "등록됨",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "driverId": "drv_3f9a1c2b4d5e",
                  "carToken": "(차량 앱이 보관)",
                  "shareScope": "status"
                }
              }
            }
          },
          "400": {
            "description": "name_required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "name_required"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "rate_limited"
                }
              }
            }
          },
          "503": {
            "description": "capacity_reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "capacity_reached"
                }
              }
            }
          }
        }
      }
    },
    "/api/car/me": {
      "get": {
        "tags": [
          "차량 앱"
        ],
        "summary": "연결된 가족과 확인 여부",
        "description": "차 화면의 가족 카드에 쓴다. 누가 연결됐는지, 최근 요약을 누가 확인했는지 돌려준다.",
        "security": [
          {
            "carToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "현재 상태",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "name": "김정숙",
                  "shareScope": "evidence",
                  "family": [
                    {
                      "name": "김민수"
                    }
                  ],
                  "latest": {
                    "week": "2026-11-09",
                    "status": "talk",
                    "sentAt": 1794321531724,
                    "ackedBy": [
                      "김민수"
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "description": "unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "unauthorized"
                }
              }
            }
          }
        }
      }
    },
    "/api/car/share-scope": {
      "put": {
        "tags": [
          "차량 앱"
        ],
        "summary": "가족에게 보내는 범위 바꾸기",
        "description": "`status`는 상태만, `evidence`는 상태와 숫자 근거다. `status`로 바꾸면 이미 저장된 숫자도 가족에게 보이지 않는다.",
        "security": [
          {
            "carToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "shareScope"
                ],
                "properties": {
                  "shareScope": {
                    "$ref": "#/components/schemas/ShareScope"
                  }
                }
              },
              "example": {
                "shareScope": "evidence"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "바뀜",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "shareScope": "evidence"
                }
              }
            }
          },
          "400": {
            "description": "invalid_scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_scope"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "unauthorized"
                }
              }
            }
          }
        }
      }
    },
    "/api/car/invites": {
      "post": {
        "tags": [
          "차량 앱"
        ],
        "summary": "초대 코드 발급",
        "description": "차 화면에 띄울 6자리 코드를 만든다. 10분 동안, 한 번만 쓸 수 있다. 새 코드를 만들면 같은 운전자의 이전 코드는 못 쓴다. QR에는 `https://drive.olvend.com/family/?code=코드`를 담으면 폰 화면에 코드가 미리 채워진다.",
        "security": [
          {
            "carToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "발급됨",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "code": "482913",
                  "expiresAt": 1794322131724
                }
              }
            }
          },
          "401": {
            "description": "unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "unauthorized"
                }
              }
            }
          }
        }
      }
    },
    "/api/car/summaries": {
      "post": {
        "tags": [
          "차량 앱"
        ],
        "summary": "주간 요약 보내기",
        "description": "부모님이 주간 카드에서 `가족에게 보내기`를 눌렀을 때 부른다. 같은 주에 다시 보내면 덮어쓰고 가족의 확인 표시가 지워진다. 운전자의 범위가 `status`이면 `evidence`는 버린다. 목록에 없는 항목도 버린다.",
        "security": [
          {
            "carToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SummaryInput"
              },
              "example": {
                "week": "2026-11-09",
                "status": "talk",
                "headline": "",
                "goodPoints": [
                  "밤 운전 0회"
                ],
                "promise": "해 지면 운전 안 하기 · 이번 주 지킴",
                "avoided": "",
                "changes": [
                  "강한 제동이 4주째, 조향 보정이 2주째 평소보다 많았어요"
                ],
                "evidence": [
                  {
                    "label": "강한 제동",
                    "unit": "회/100km",
                    "typical": 6.3,
                    "value": 21.9,
                    "weeks": 4
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "저장됨",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "week": "2026-11-09",
                  "status": "talk",
                  "evidenceStored": 1
                }
              }
            }
          },
          "400": {
            "description": "invalid_week / invalid_status / invalid_json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_week"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "unauthorized"
                }
              }
            }
          },
          "413": {
            "description": "body_too_large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "body_too_large"
                }
              }
            }
          }
        }
      }
    },
    "/api/family/members": {
      "post": {
        "tags": [
          "가족 폰"
        ],
        "summary": "가족으로 가입",
        "description": "이름만 받는다. 휴대폰 번호와 인증은 없다.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 20
                  }
                }
              },
              "example": {
                "name": "김민수"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "가입됨",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "memberId": "mem_8b2c4d6e0f1a",
                  "token": "(브라우저가 보관)",
                  "name": "김민수"
                }
              }
            }
          },
          "400": {
            "description": "name_required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "name_required"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "rate_limited"
                }
              }
            }
          },
          "503": {
            "description": "capacity_reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "capacity_reached"
                }
              }
            }
          }
        }
      }
    },
    "/api/family/links": {
      "post": {
        "tags": [
          "가족 폰"
        ],
        "summary": "초대 코드로 부모님 차와 연결",
        "description": "차 화면의 코드를 넣는다. 10분 안에 5번 틀리면 그 가족은 10분 동안 막힌다. 한 주소(IP)에서는 10분에 10번까지 시도할 수 있다.",
        "security": [
          {
            "familyToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "code"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "pattern": "^[0-9]{6}$"
                  },
                  "relation": {
                    "type": "string",
                    "maxLength": 10,
                    "description": "호칭. 비우면 `부모님`"
                  }
                }
              },
              "example": {
                "code": "482913",
                "relation": "엄마"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "연결됨",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "driverId": "drv_3f9a1c2b4d5e",
                  "name": "김정숙",
                  "relation": "엄마"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "unauthorized"
                }
              }
            }
          },
          "404": {
            "description": "invalid_code / expired_code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_code"
                }
              }
            }
          },
          "429": {
            "description": "too_many_attempts / rate_limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "too_many_attempts"
                }
              }
            }
          }
        }
      }
    },
    "/api/family/overview": {
      "get": {
        "tags": [
          "가족 폰"
        ],
        "summary": "가족 목록",
        "description": "연결된 운전자와 각자의 최근 요약 상태다. 폰 화면이 4초마다 부른다.",
        "security": [
          {
            "familyToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "목록",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "name": "김민수",
                  "drivers": [
                    {
                      "driverId": "drv_3f9a1c2b4d5e",
                      "name": "김정숙",
                      "relation": "엄마",
                      "latest": {
                        "week": "2026-11-09",
                        "status": "talk",
                        "sentAt": 1794321531724,
                        "acked": false
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "unauthorized"
                }
              }
            }
          }
        }
      }
    },
    "/api/family/drivers/{driverId}/summary": {
      "get": {
        "tags": [
          "가족 폰"
        ],
        "summary": "최근 주간 요약",
        "description": "연결된 운전자의 최근 요약이다. 아직 없으면 `summary`가 null이다. `evidenceShared`가 false이면 `evidence`는 항상 빈 배열이다.",
        "security": [
          {
            "familyToken": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/driverId"
          }
        ],
        "responses": {
          "200": {
            "description": "요약",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "driverId": "drv_3f9a1c2b4d5e",
                  "name": "김정숙",
                  "relation": "엄마",
                  "summary": {
                    "week": "2026-11-09",
                    "status": "talk",
                    "headline": "",
                    "goodPoints": [
                      "밤 운전 0회"
                    ],
                    "promise": "해 지면 운전 안 하기 · 이번 주 지킴",
                    "avoided": "",
                    "changes": [
                      "강한 제동이 4주째, 조향 보정이 2주째 평소보다 많았어요"
                    ],
                    "evidence": [
                      {
                        "label": "강한 제동",
                        "unit": "회/100km",
                        "typical": 6.3,
                        "value": 21.9,
                        "weeks": 4
                      }
                    ],
                    "evidenceShared": true,
                    "sentAt": 1794321531724,
                    "acked": false
                  }
                }
              }
            }
          },
          "401": {
            "description": "unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "unauthorized"
                }
              }
            }
          },
          "403": {
            "description": "not_linked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "not_linked"
                }
              }
            }
          }
        }
      }
    },
    "/api/family/drivers/{driverId}/ack": {
      "post": {
        "tags": [
          "가족 폰"
        ],
        "summary": "요약을 확인했다고 표시",
        "description": "`확인했어요`를 눌렀을 때 부른다. 차 화면의 가족 카드에 나타난다.",
        "security": [
          {
            "familyToken": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/driverId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "week"
                ],
                "properties": {
                  "week": {
                    "type": "string",
                    "format": "date"
                  }
                }
              },
              "example": {
                "week": "2026-11-09"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "표시됨",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "week": "2026-11-09",
                  "acked": true
                }
              }
            }
          },
          "401": {
            "description": "unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "unauthorized"
                }
              }
            }
          },
          "403": {
            "description": "not_linked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "not_linked"
                }
              }
            }
          },
          "404": {
            "description": "no_summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "no_summary"
                }
              }
            }
          }
        }
      }
    },
    "/api/car/backup": {
      "get": {
        "tags": [
          "차량 앱"
        ],
        "security": [
          {
            "carToken": []
          }
        ],
        "summary": "보관한 주행 기록과 설정 불러오기",
        "description": "앱을 다시 설치했을 때 복원한다. 가족 토큰으로는 읽을 수 없다.",
        "responses": {
          "200": {
            "description": "보관 상태",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "enabled": true,
                  "profile": {
                    "promises": [
                      0,
                      1
                    ],
                    "marked": [
                      {
                        "place": "병원",
                        "point": "중앙대로 합류"
                      }
                    ]
                  },
                  "trips": [
                    {
                      "week": "2026-11-09",
                      "place": "병원",
                      "km": 10,
                      "night": false,
                      "reroutes": 2,
                      "turns": 3,
                      "signals": 2,
                      "hardBrakes": 1
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "unauthorized",
            "content": {
